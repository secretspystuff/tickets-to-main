{
  "name": "admission",
  "fabricated": true,
  "shows": "One batch is one queued job and takes no lane. The same key and body replay that job. The same key with a different body does not create a second job.",
  "wire": [
    {
      "role": "request",
      "document": {
        "protocol": "tickets-to-main.coordination",
        "version": 1,
        "command": "job.admit",
        "id": "fab00000000000000000000000000009",
        "idempotency_key": "fab-admit-1",
        "body": {
          "repo": {
            "host": "example.com",
            "owner": "fabricated-owner",
            "name": "fabricated-repo",
            "board_repo_id": "fabricated-board-repo"
          },
          "members": [
            "fab00000000000000000000000000016",
            "fab00000000000000000000000000017"
          ],
          "expected_revision": null
        }
      }
    },
    {
      "role": "response",
      "document": {
        "protocol": "tickets-to-main.coordination",
        "version": 1,
        "command": "job.admit",
        "id": "fab00000000000000000000000000009",
        "idempotency_key": "fab-admit-1",
        "body": {
          "job_id": "fab00000000000000000000000000018",
          "state": "queued",
          "lane_id": null,
          "revision": 1,
          "members": [
            "fab00000000000000000000000000016",
            "fab00000000000000000000000000017"
          ]
        }
      }
    },
    {
      "role": "refusal",
      "document": {
        "protocol": "tickets-to-main.coordination",
        "version": 1,
        "command": "job.admit",
        "id": "fab0000000000000000000000000000a",
        "idempotency_key": "fab-admit-2",
        "error": "That Idempotency-Key was already used for a different action.",
        "code": "idempotency_conflict",
        "field": "idempotency_key",
        "fix": "Repeat the original action, or use a new key for a new one.",
        "then": "stop"
      }
    }
  ],
